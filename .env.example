# ============================================================
# FlowMoney AI — environment template
# Copy to .env and fill in. NEVER commit a real .env.
# ============================================================

NODE_ENV=development
LOG_LEVEL=info

# ---------- Database ----------
# docker compose default; change if you run Postgres elsewhere
DATABASE_URL=postgresql://flowmoney:flowmoney@localhost:5432/flowmoney?schema=public

# ---------- Redis (cache + BullMQ queues) ----------
REDIS_URL=redis://localhost:6379

# ---------- API ----------
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# ---------- Auth ----------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECRET=replace_me_with_a_long_random_string
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ---------- Encryption (sensitive financial fields at rest) ----------
# 32-byte key, base64. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace_me_with_base64_32_byte_key

# ---------- OpenAI ----------
# Leave empty to run the deterministic offline template renderer instead of the LLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TIMEOUT_MS=45000

# ---------- WhatsApp ----------
# provider: meta | twilio | mock
WHATSAPP_PROVIDER=mock
WHATSAPP_VERIFY_TOKEN=flowmoney_verify_token
# Meta WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Twilio (only if WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---------- Voice ----------
# provider: mock | twilio
VOICE_PROVIDER=mock
VOICE_REPLY_ENABLED=true

# ---------- Object storage (S3-compatible; MinIO in docker compose) ----------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=flowmoney
S3_ACCESS_KEY_ID=flowmoney
S3_SECRET_ACCESS_KEY=flowmoney123
S3_FORCE_PATH_STYLE=true

# ---------- Banking / payments ----------
BANKING_PROVIDER=mock
PAYMENT_PROVIDER=mock

# ---------- Rate limiting ----------
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=FlowMoney AI

# ---------- Seed / demo ----------
SEED_DEFAULT_PASSWORD=Password123!

# ---------- Worker (scheduled jobs) ----------
# Minutes between idle-cash / anomaly / budget-alert / health-snapshot sweeps
SWEEP_INTERVAL_MINUTES=1440
# Minutes between checks for a month having just completed (monthly reports)
MONTHLY_REPORT_CHECK_MINUTES=60
