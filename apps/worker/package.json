{
  "name": "@flowmoney/worker",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@flowmoney/database": "workspace:*",
    "@flowmoney/financial-engine": "workspace:*",
    "@flowmoney/shared-types": "workspace:*",
